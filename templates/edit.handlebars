<h1>Edit details</h1>

<form action="/edit-details/{{employee.employeeId}}" method="post">
    <label for="name">
        Name:
        <input type="text" name="name" id="name" value="{{employee.name}}">
    </label>
    <br>
    <label for="phone">
        Phone:
        <input type="text" name="phone" id="phone" value="{{employee.phone}}">
    </label>
    <br>
    <input type="submit" value="Save">
</form>