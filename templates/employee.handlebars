<style>
    table,th,td,tr{
        border: 2px solid black;
        border-collapse: collapse;
    }
    .morning-highlight{
        background-color: yellow;
    }
</style>

<h1>Employee Details</h1>

<p><strong>ID:</strong> {{employee.employeeId}}</p>
<p><strong>Name:</strong> {{employee.name}}</p>
<p><strong>Phone:</strong> {{employee.phone}}</p>

<p><a href="/edit-details/{{employee._id}}">edit details</a></p>

<h1>Shifts</h1>
<table>
    <tr>
        <th>date</th>
        <th>start time</th>
        <th>end time</th>
    </tr>
    {{#each shifts}}
    <tr>
        <td>{{this.date}}</td>
        <td class="{{#if this.isMorning}}morning-highlight{{/if}}">{{this.startTime}}</td>
        <td>{{this.endTime}}</td>
    </tr>
    {{/each}}
</table>

<h2>Upload Document</h2>

<form action="/employee/{{employee._id}}/documents" method="POST" enctype="multipart/form-data">
    <input type="file" name="document" required>
    <button type="submit">Upload</button>
</form>

<h2>Documents</h2>

<ul>
    {{#each documents}}
        <li>
            <a href="/documents/{{this.filename}}" target="_blank">
                {{this.originalname}}
            </a>
        </li>
    {{/each}}
</ul>

<a href="/">Back</a>

